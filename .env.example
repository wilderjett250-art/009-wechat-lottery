MYSQL_DATABASE=lottery_tool
MYSQL_USER=lottery_app
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
ADMIN_TOKEN=replace-with-a-long-random-admin-token
ADMIN_SESSION_LIFETIME_MS=28800000
HIDE_SAMPLE_DATA=true
MINIPROGRAM_LAUNCH_URL=

WECHAT_APPID=wxexampleappid0001
WECHAT_APP_SECRET=replace-with-mini-program-app-secret
# 开奖结果通知：活动名称、奖品名称、开奖结果、开奖时间
WECHAT_DRAW_TEMPLATE_ID=replace-with-draw-result-template-id
WECHAT_DRAW_TEMPLATE_DATA={"thing10":{"value":"{{activityTitle}}"},"thing2":{"value":"{{prizeName}}"},"thing4":{"value":"{{result}}"},"time7":{"value":"{{drawAt}}"},"thing1":{"value":"请进入小程序查看详情"}}
# 开奖提醒通知：活动名称、开奖时间、温馨提示。
WECHAT_DRAW_REMINDER_TEMPLATE_ID=replace-with-draw-reminder-template-id
WECHAT_DRAW_REMINDER_TEMPLATE_DATA={"thing1":{"value":"{{activityTitle}}"},"time6":{"value":"{{drawAt}}"},"thing5":{"value":"{{reminderText}}"}}
# 红包到账通知：获得时间、红包说明、红包金额；未配置时不会错误使用开奖结果模板。
WECHAT_CASH_TEMPLATE_ID=
WECHAT_CASH_TEMPLATE_DATA={"date1":{"value":"{{cashReceivedAt}}"},"thing4":{"value":"{{cashDescription}}"},"amount5":{"value":"{{cashAmount}}"}}
WECHAT_COMMENT_TEMPLATE_ID=replace-with-comment-template-id
WECHAT_COMMENT_TEMPLATE_DATA={"thing1":{"value":"{{commenterName}}"},"thing2":{"value":"{{commentAt}}"},"thing3":{"value":"{{commentContent}}"},"thing4":{"value":"请进入小程序查看并回复"}}
WECHAT_NOTIFY_PAGE=pages/records/records
WECHAT_MINIPROGRAM_STATE=formal
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAYS_MS=60000,300000,1800000,7200000
DRAW_REMINDER_LEAD_MS=1800000
RELEASE_VERSION=1.4.5
SESSION_LIFETIME_MS=2592000000
MAX_STORED_SESSIONS=10000
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=20
ACTIVITY_ACTION_RATE_LIMIT_WINDOW_MS=60000
ACTIVITY_ACTION_RATE_LIMIT_MAX=90

WECHAT_PAY_MCH_ID=replace-with-merchant-id
WECHAT_PAY_SERIAL_NO=replace-with-merchant-certificate-serial
WECHAT_PAY_PRIVATE_KEY_PATH=/app/secrets/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=replace-with-32-character-api-v3-key
WECHAT_PAY_PLATFORM_SERIAL_NO=replace-with-platform-certificate-serial-or-public-key-id
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/app/secrets/wechatpay_platform.pem
WECHAT_PAY_NOTIFY_URL=https://lottery.example.com/api/payments/wechat/notify
ADVANCED_FEATURE_PRICE_CENTS=0

# 微信开放平台第三方平台，用于让抽奖发起人授权自己的公众号
WECHAT_OPEN_COMPONENT_APPID=replace-with-third-party-platform-appid
WECHAT_OPEN_COMPONENT_APP_SECRET=replace-with-third-party-platform-app-secret
WECHAT_OPEN_COMPONENT_TOKEN=replace-with-third-party-platform-message-token
WECHAT_OPEN_COMPONENT_AES_KEY=replace-with-43-character-encoding-aes-key
WECHAT_OPEN_PUBLIC_BASE_URL=https://lottery.example.com
WECHAT_OPEN_AUTH_REDIRECT_URL=https://lottery.example.com/api/wechat/open-platform/authorization/callback
