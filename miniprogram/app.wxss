page {
  color: #111827;
  background: #f1f2f5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.official-home {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: #f4f4f4;
}

.official-hero {
  position: relative;
  min-height: 920rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 28% 23%, rgba(255, 124, 40, .34), transparent 23%),
    linear-gradient(180deg, #f3314e 0%, #f7627b 52%, #fff 100%);
}

.official-hero::before {
  content: "";
  position: absolute;
  left: -80rpx;
  right: -80rpx;
  bottom: 88rpx;
  height: 360rpx;
  background:
    linear-gradient(rgba(255, 255, 255, .2) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(255, 255, 255, .2) 2rpx, transparent 2rpx);
  background-size: 64rpx 64rpx;
  opacity: .7;
  transform: perspective(420rpx) rotateX(58deg);
  transform-origin: bottom;
}

.official-hero::after {
  content: "";
  position: absolute;
  left: -40rpx;
  right: -40rpx;
  bottom: -2rpx;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), #f4f4f4 72%);
}

.mini-status {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  padding: 28rpx 70rpx 0;
  color: #030303;
  font-size: 48rpx;
  font-weight: 900;
}

.mini-status-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.mini-signal {
  display: flex;
  align-items: flex-end;
  gap: 5rpx;
  height: 36rpx;
}

.mini-signal text {
  display: block;
  width: 12rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #030303;
}

.mini-signal text:nth-child(1) {
  height: 14rpx;
}

.mini-signal text:nth-child(2) {
  height: 22rpx;
}

.mini-signal text:nth-child(3) {
  height: 30rpx;
}

.mini-signal text:nth-child(4) {
  height: 36rpx;
}

.mini-network {
  font-size: 40rpx;
  font-weight: 900;
}

.mini-battery {
  min-width: 56rpx;
  height: 42rpx;
  border-radius: 14rpx;
  color: #fff;
  background: #37c65b;
  text-align: center;
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.official-title {
  position: relative;
  z-index: 2;
  display: block;
  margin: 176rpx 0 50rpx;
  color: #fff;
  text-align: center;
  font-size: 66rpx;
  line-height: 1;
  font-weight: 900;
}

.prize-carousel {
  position: relative;
  z-index: 3;
  white-space: nowrap;
  padding-left: 132rpx;
}

.official-prize-card {
  display: inline-block;
  width: 560rpx;
  padding: 22rpx 22rpx 42rpx;
  border-radius: 34rpx;
  background: #fff;
  box-shadow: 0 34rpx 80rpx rgba(30, 20, 20, .12);
  text-align: center;
}

.official-prize-card image {
  width: 516rpx;
  height: 454rpx;
  border-radius: 18rpx;
}

.official-prize-name {
  display: block;
  margin: 40rpx 0 34rpx;
  color: #111827;
  font-size: 40rpx;
  font-weight: 500;
}

.official-prize-card button {
  width: 280rpx;
  height: 98rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #ee423d;
  font-size: 38rpx;
  font-weight: 900;
}

.ghost-prize-card {
  display: inline-block;
  width: 390rpx;
  height: 620rpx;
  margin-left: 220rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, .78);
}

.cash-section {
  position: relative;
  z-index: 4;
  margin-top: -8rpx;
  padding: 0 36rpx;
  background: #f4f4f4;
}

.cash-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.cash-title {
  display: block;
  margin-bottom: 14rpx;
  color: #111827;
  font-size: 56rpx;
  font-weight: 900;
}

.cash-subtitle {
  display: block;
  color: #777;
  font-size: 30rpx;
}

.cash-head button {
  width: 124rpx;
  height: 72rpx;
  border: 2rpx solid #d8d8d8;
  border-radius: 40rpx;
  color: #777;
  background: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.cash-scroll {
  white-space: nowrap;
  padding-bottom: 34rpx;
}

.cash-track {
  display: inline-flex;
  align-items: flex-start;
}

.cash-card {
  position: relative;
  display: flex;
  flex: 0 0 250rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 250rpx;
  height: 300rpx;
  margin-right: 18rpx;
  overflow: hidden;
  border-radius: 16rpx;
  color: #fff;
  background: #ef473f;
  vertical-align: top;
}

.cash-card::before,
.cash-card::after {
  content: "";
  position: absolute;
  top: 150rpx;
  width: 86rpx;
  height: 36rpx;
  border-bottom: 6rpx solid rgba(255, 248, 232, .9);
  border-radius: 50%;
}

.cash-card::before {
  left: -44rpx;
  transform: rotate(12deg);
}

.cash-card::after {
  right: -44rpx;
  transform: rotate(-12deg);
}

.cash-card.first image {
  position: absolute;
  inset: 0;
  width: 250rpx;
  height: 300rpx;
}

.cash-date {
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
}

.cash-card.first .cash-date {
  position: absolute;
  top: 118rpx;
}

.draw-circle {
  position: absolute;
  bottom: 34rpx;
  display: grid;
  place-items: center;
  width: 110rpx;
  height: 110rpx;
  border: 6rpx solid #f3d6b3;
  border-radius: 50%;
  color: #c87619;
  background: #fff8df;
  font-size: 56rpx;
  font-weight: 900;
}

.cash-money {
  display: block;
  margin-bottom: 22rpx;
  color: #fff;
  font-size: 58rpx;
  font-weight: 500;
}

.cash-card button {
  margin-top: 38rpx;
  color: #fff;
  background: transparent;
  font-size: 38rpx;
  font-weight: 900;
}

button {
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1.2;
}

.discover-page {
  min-height: 100vh;
  padding: 8rpx 14rpx 22rpx;
  background: #ffffff;
}

.discover-section {
  padding: 30rpx 14rpx 150rpx;
  background: #fff;
}

.section-top {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx 18rpx;
}

.section-title {
  display: block;
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.subscribe-pill {
  display: flex;
  justify-content: flex-end;
  padding: 0 210rpx 10rpx 0;
}

.subscribe-pill text {
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  color: #c80f2e;
  background: #fff1f4;
  font-size: 26rpx;
}

.discover-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.lottery-card {
  display: block;
  width: 354rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 2rpx 0 rgba(17, 24, 39, .06);
  padding: 0;
  text-align: left;
  line-height: normal;
}

.lottery-card image {
  width: 100%;
  height: 464rpx;
  background: #eef0f3;
}

.card-body {
  padding: 14rpx 14rpx 16rpx;
}

.card-title {
  display: block;
  color: #101318;
  font-size: 29rpx;
  line-height: 1.28;
}

.countdown {
  display: block;
  margin-top: 12rpx;
  color: #9ba0aa;
  font-size: 25rpx;
}

.countdown text {
  color: #d01631;
}

.organizer-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.organizer-mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #c80f2e;
}

.organizer-name {
  flex: 1;
  color: #2f333a;
  font-size: 27rpx;
  font-weight: 800;
}

.arrow {
  color: #8d929a;
  font-size: 42rpx;
}

.create-page,
.records-page,
.profile-page {
  min-height: 100vh;
  background: #f1f2f5;
}

.create-page {
  padding: 220rpx 26rpx 36rpx;
}

.create-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.create-tile {
  min-height: 138rpx;
  padding: 30rpx 26rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #fff 0%, #fff5f3 100%);
  text-align: left;
}

.create-tile.feature {
  opacity: .34;
}

.create-title {
  display: block;
  color: #111827;
  font-size: 31rpx;
  font-weight: 900;
}

.create-desc {
  display: block;
  margin-top: 12rpx;
  color: #9aa0aa;
  font-size: 25rpx;
}

.machine-list {
  display: grid;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.machine-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 14rpx;
  color: #1f2329;
  background: linear-gradient(180deg, #fff 0%, #fff8f8 100%);
  font-size: 31rpx;
  font-weight: 900;
}

.create-links {
  padding-top: 36rpx;
  color: #6b7280;
  text-align: center;
  font-size: 24rpx;
}

.record-tabs {
  display: flex;
  height: 82rpx;
  background: #fff;
}

.record-tab {
  position: relative;
  flex: 1;
  color: #111827;
  font-size: 29rpx;
  line-height: 82rpx;
  text-align: center;
  background: #fff;
}

.record-tabs .active {
  color: #c80f2e;
}

.record-tabs .active::after {
  content: "";
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 0;
  height: 4rpx;
  background: #c80f2e;
}

.recommend-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  padding: 0 14rpx 0 36rpx;
  background: #fff4e3;
  color: #e6a554;
  font-size: 22rpx;
}

.recommend-action {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  color: #fff;
  background: #ff8b31;
  font-weight: 800;
}

.record-card {
  display: flex;
  align-items: center;
  width: 722rpx;
  box-sizing: border-box;
  min-height: 112rpx;
  margin: 18rpx 14rpx 0;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #fff;
  text-align: left;
  line-height: normal;
}

.record-card image {
  flex: 0 0 auto;
  width: 120rpx;
  height: 84rpx;
  margin-right: 16rpx;
  border-radius: 6rpx;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.22;
}

.record-time {
  display: block;
  margin-top: 18rpx;
  color: #9aa0aa;
  font-size: 24rpx;
}

.record-status {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 8rpx 14rpx;
  border: 2rpx solid #8fd7c0;
  border-radius: 8rpx;
  color: #1f8d6a;
  font-size: 24rpx;
}

.record-note {
  display: block;
  margin: 18rpx 0 26rpx;
  color: #9aa0aa;
  text-align: center;
  font-size: 24rpx;
}

.template-banner {
  display: grid;
  place-items: center;
  width: 722rpx;
  box-sizing: border-box;
  height: 174rpx;
  margin: 0 14rpx;
  border-radius: 14rpx;
  color: #fff;
  background:
    radial-gradient(circle at 18% 18%, rgba(255, 255, 255, .58), transparent 18%),
    radial-gradient(circle at 82% 80%, rgba(15, 111, 72, .45), transparent 24%),
    linear-gradient(135deg, #b9efc3 0%, #54ca62 54%, #2bae50 100%);
  font-size: 46rpx;
  font-weight: 900;
}

.empty-record {
  display: grid;
  place-items: center;
  height: 720rpx;
  color: #9aa0aa;
  font-size: 26rpx;
}

.empty-icon {
  color: #c9cdd3;
  font-size: 110rpx;
  text-align: center;
}

.profile-page {
  padding: 14rpx;
}

.profile-login,
.profile-row {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  min-height: 116rpx;
  padding: 0 28rpx;
  border-bottom: 2rpx solid #edf0f4;
  background: #fff;
  text-align: left;
}

.profile-row {
  justify-content: space-between;
}

.profile-login {
  min-height: 156rpx;
  margin-bottom: 14rpx;
  border-radius: 14rpx;
  border-bottom: 0;
}

.profile-avatar {
  display: grid;
  place-items: center;
  width: 102rpx;
  height: 102rpx;
  margin-right: 28rpx;
  border-radius: 50%;
  color: #fff;
  background: #e5e7eb;
  font-size: 34rpx;
  font-weight: 900;
}

.profile-title,
.profile-row text:first-child {
  flex: 1;
  font-size: 31rpx;
  font-weight: 500;
}

.profile-arrow {
  color: #bdc2ca;
  font-size: 44rpx;
}

.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
  background: #f3f4f6;
}

.detail-topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 48rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 22rpx;
  pointer-events: none;
}

.detail-back {
  display: grid;
  place-items: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  color: #111827;
  background: rgba(255, 255, 255, .86);
  pointer-events: auto;
}

.detail-back-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
  border-bottom: 4rpx solid #111827;
  border-left: 4rpx solid #111827;
  transform: rotate(45deg);
}

.detail-hero {
  position: relative;
  height: 740rpx;
  overflow: hidden;
  background: #030712;
}

.detail-hero image {
  width: 100%;
  height: 740rpx;
  object-position: center top;
}

.ticker {
  position: absolute;
  left: 0;
  top: 138rpx;
  color: #fff;
  font-size: 25rpx;
  white-space: nowrap;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .34);
}

.detail-card,
.sponsor-card,
.join-rank,
.notice-box {
  margin: 14rpx 14rpx 0;
  border-radius: 14rpx;
  background: #fff;
}

.detail-card {
  padding: 22rpx;
}

.detail-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.prize-summary {
  display: grid;
  grid-template-columns: 160rpx 1fr;
  gap: 18rpx;
  align-items: center;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #f5f6f8;
}

.prize-summary image {
  width: 150rpx;
  height: 126rpx;
  border-radius: 9rpx;
}

.prize-name {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
}

.prize-rule {
  display: block;
  margin-top: 14rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.draw-time {
  display: block;
  margin-top: 18rpx;
  color: #5d6470;
  font-size: 27rpx;
}

.sponsor-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
}

.verified {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border: 2rpx solid #8bd3ff;
  border-radius: 6rpx;
  color: #2384bb;
  font-size: 22rpx;
}

.join-rank {
  padding: 22rpx 28rpx;
}

.join-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  max-width: 100%;
  height: 84rpx;
  margin: 0 auto;
  padding: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #fff;
  background: #c80f2e;
  font-size: 32rpx;
  line-height: 84rpx;
  font-weight: 900;
}

.join-rank text {
  display: block;
  margin-top: 16rpx;
  color: #666c76;
  text-align: center;
  font-size: 25rpx;
}

.notice-box {
  padding: 28rpx;
}

.notice-box text {
  display: block;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.55;
}

.notice-box .notice-title {
  margin-bottom: 10rpx;
  color: #111827;
  font-weight: 900;
}

.detail-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: grid;
  grid-template-columns: 240rpx 1fr;
  gap: 14rpx;
  align-items: center;
  min-height: 104rpx;
  padding: 12rpx 16rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff;
  border-top: 2rpx solid #edf0f4;
}

.detail-bottom button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 9rpx;
  color: #c80f2e;
  background: #fff2f4;
  font-size: 28rpx;
  font-weight: 800;
}

.detail-bottom button:last-child {
  color: #fff;
  background: #c80f2e;
}

/* Create lottery page */
.create-tool-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx 128rpx;
  background: #f1f2f5;
}

.launch-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx 24rpx 178rpx;
  background: #f1f2f5;
}

.create-hero {
  position: relative;
  min-height: 328rpx;
  margin: 0 -24rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 28% 28%, rgba(255, 203, 80, .32), transparent 22%),
    linear-gradient(180deg, #f50f18 0%, #fb6077 68%, #f1f2f5 100%);
}

.create-hero::after {
  content: "";
  position: absolute;
  left: 58rpx;
  right: 58rpx;
  bottom: 28rpx;
  height: 110rpx;
  border: 6rpx solid rgba(186, 18, 28, .26);
  border-top-width: 8rpx;
  border-radius: 50%;
  transform: rotate(-4deg);
}

.create-search {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  z-index: 2;
  min-width: 140rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  color: #8d8d8d;
  background: rgba(255, 255, 255, .94);
  font-size: 28rpx;
  line-height: 64rpx;
}

.create-slogan {
  position: relative;
  z-index: 2;
  display: block;
  padding-top: 142rpx;
  color: #fff;
  text-align: center;
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 900;
  text-shadow: 0 6rpx 14rpx rgba(196, 22, 30, .22);
}

.create-template-grid {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: -62rpx;
}

.create-template {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 128rpx;
  box-sizing: border-box;
  padding: 24rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #fff 0%, #fff8f6 100%);
  box-shadow: 0 12rpx 28rpx rgba(98, 43, 38, .08);
}

.create-template.feature {
  grid-row: span 2;
  align-items: flex-start;
  min-height: 272rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff5d50 0%, #ffb66c 100%);
}

.create-template.feature::after {
  content: "↗";
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  color: rgba(255, 255, 255, .28);
  font-size: 118rpx;
  font-weight: 900;
}

.create-template-title {
  display: block;
  color: #181c23;
  font-size: 31rpx;
  line-height: 1.2;
  font-weight: 900;
}

.create-template.feature .create-template-title {
  color: #fff;
}

.create-template-desc {
