  margin: 18rpx 18rpx 20rpx;
  padding: 24rpx 22rpx 26rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, .07);
}

.redesigned-home .cash-head {
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 0;
}

.redesigned-home .cash-title {
  font-size: 34rpx;
  line-height: 1.14;
  color: #0f172a;
}

.redesigned-home .cash-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.28;
}

.redesigned-home .cash-head button {
  width: 104rpx;
  height: 54rpx;
  border-color: #e8ebf0;
  border-radius: 30rpx;
  color: #667085;
  line-height: 50rpx;
}

.redesigned-home .cash-scroll {
  width: 100%;
  margin: 0;
  padding: 0;
  white-space: nowrap;
}

.redesigned-home .cash-track {
  gap: 16rpx;
  padding: 0;
}

.redesigned-home .cash-card,
.redesigned-home .cash-card.first {
  flex: 0 0 214rpx;
  width: 214rpx;
  height: 200rpx;
  margin-right: 0;
  border-radius: 18rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, .18), rgba(255, 255, 255, 0) 42%),
    linear-gradient(160deg, #ff5c54 0%, #f23f39 68%, #ec342f 100%);
  box-shadow: 0 10rpx 20rpx rgba(222, 56, 50, .14);
}

.redesigned-home .cash-card::before,
.redesigned-home .cash-card::after {
  top: 90rpx;
  width: 22rpx;
  height: 22rpx;
  border: 0;
  border-radius: 50%;
  background: #fff;
  opacity: 1;
  box-shadow: none;
  transform: none;
  z-index: 4;
}

.redesigned-home .cash-card::before {
  left: -11rpx;
}

.redesigned-home .cash-card::after {
  right: -11rpx;
}

.redesigned-home .cash-card.first image {
  display: none;
}

.redesigned-home .cash-money {
  top: 24rpx;
  color: #fff;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 900;
  z-index: 2;
}

.redesigned-home .cash-date {
  top: 78rpx;
  left: 16rpx;
  right: 16rpx;
  color: #fff;
  font-size: 24rpx;
  line-height: 1.22;
  font-weight: 900;
  z-index: 2;
}

.redesigned-home .cash-card.first .cash-date {
  top: 24rpx;
  font-size: 25rpx;
}

.redesigned-home .draw-circle {
  top: 62rpx;
  bottom: auto;
  width: 78rpx;
  height: 78rpx;
  margin-left: -39rpx;
  border-width: 5rpx;
  font-size: 39rpx;
  line-height: 78rpx;
  box-shadow: 0 6rpx 14rpx rgba(151, 80, 24, .14);
  z-index: 2;
}

.redesigned-home .cash-action {
  left: 50%;
  right: auto;
  bottom: 16rpx;
  width: 154rpx;
  height: 42rpx;
  margin-left: -77rpx;
  border-radius: 24rpx;
  color: #c43632;
  background: #fff5df;
  font-size: 24rpx;
  line-height: 42rpx;
  font-weight: 900;
  z-index: 2;
}

.redesigned-home .cash-action.is-reminded {
  color: #cf3630;
  background: #fff2d2;
}

.redesigned-home .discover-section {
  border-top: 0;
}

/* 2026-07-04 reference alignment */
.discover-feed-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 10rpx;
  padding-right: 10rpx;
  padding-bottom: 132rpx;
  background: #ffffff;
}

.discover-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: #fff;
}

.discover-nav-spacer {
  width: 96rpx;
}

.discover-title-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-width: 0;
}

.discover-title {
  color: #111827;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 500;
}

.subscribe-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 22rpx;
  color: #d70c25;
  background: #fff0f2;
  font-size: 22rpx;
  line-height: 42rpx;
}

.subscribe-dot {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #d70c25;
  border-radius: 50%;
  box-sizing: border-box;
}

.discover-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding-top: 10rpx;
}

.discover-card {
  min-width: 0;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 2rpx 0 rgba(15, 23, 42, .05);
}

.discover-cover {
  display: block;
  width: 100%;
  height: 486rpx;
  background: #eef0f3;
}

.discover-card-body {
  padding: 12rpx 16rpx 16rpx;
  box-sizing: border-box;
}

.discover-card-title {
  display: block;
  min-height: 38rpx;
  color: #111827;
  font-size: 27rpx;
  line-height: 1.35;
  word-break: break-all;
}

.discover-countdown {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 10rpx;
  color: #8b919c;
  font-size: 24rpx;
  line-height: 1.2;
}

.countdown-time {
  color: #d70c25;
}

.discover-tool-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  min-width: 0;
}

.tool-logo {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #fff;
  background: #e11d2f;
  text-align: center;
  font-size: 22rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.tool-name {
  flex: 1;
  min-width: 0;
  color: #20242b;
  font-size: 26rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 700;
}

.tool-arrow {
  flex: 0 0 auto;
  color: #8d949e;
  font-size: 36rpx;
  line-height: 1;
}

.discover-empty {
  display: grid;
  place-items: center;
  height: 420rpx;
  color: #9aa0aa;
  font-size: 28rpx;
}

.create-reference-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx 150rpx;
  overflow: hidden;
  background: #f1f2f5;
}

.create-reference-page .create-hero {
  position: relative;
  min-height: 390rpx;
  margin: 0 -24rpx;
  padding: 46rpx 36rpx 124rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #ff111a 0%, #ff4658 52%, #ff8a88 76%, #f1f2f5 100%);
}

.create-reference-page .create-hero::after {
  content: "";
  position: absolute;
  left: 74rpx;
  right: 74rpx;
  bottom: 42rpx;
  height: 112rpx;
  border: 8rpx solid rgba(255, 255, 255, .22);
  border-top-color: rgba(255, 245, 205, .42);
  border-radius: 50%;
  transform: rotate(-5deg);
}

.create-topbar {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 154rpx 1fr 154rpx;
  align-items: center;
}

.create-search {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #8a8f99;
  background: rgba(255, 255, 255, .95);
  font-size: 25rpx;
}

.create-search-icon {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #98a0ad;
  border-radius: 50%;
  box-sizing: border-box;
}

.create-search-icon::after {
  content: "";
  position: relative;
  left: 15rpx;
  top: 14rpx;
  display: block;
  width: 10rpx;
  height: 3rpx;
  background: #98a0ad;
  transform: rotate(45deg);
}

.create-nav-title {
  color: #fff;
  text-align: center;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
}

.create-reference-page .create-slogan {
  position: relative;
  z-index: 2;
  display: block;
  padding-top: 112rpx;
  color: #fff7d7;
  text-align: center;
  font-size: 60rpx;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: 0;
  text-shadow: 0 8rpx 16rpx rgba(175, 29, 38, .28);
}

.create-reference-page .create-template-grid {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: -80rpx;
}

.create-reference-page .create-template {
  position: relative;
  min-height: 126rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #fff 0%, #fff6f3 100%);
  box-shadow: 0 8rpx 22rpx rgba(60, 31, 35, .06);
}

.create-reference-page .create-template.feature {
  grid-row: span 2;
  min-height: 272rpx;
  background: linear-gradient(135deg, #ff604f 0%, #ffd18c 100%);
}

.create-reference-page .create-template.feature::after {
  content: "↗";
  position: absolute;
  right: 16rpx;
  bottom: -12rpx;
  color: rgba(255, 255, 255, .24);
  font-size: 140rpx;
  line-height: 1;
  font-weight: 900;
}

.create-template-copy {
  position: relative;
  z-index: 2;
}

.create-reference-page .create-template-title {
  display: block;
  padding-right: 52rpx;
  color: #111827;
  font-size: 29rpx;
  line-height: 1.18;
  font-weight: 900;
}

.create-reference-page .create-template-desc {
  display: block;
  max-width: 224rpx;
  margin-top: 10rpx;
  color: #8a909c;
  font-size: 24rpx;
  line-height: 1.25;
}

.create-reference-page .create-template.feature .create-template-title {
  color: #fff;
  font-size: 34rpx;
}

.create-reference-page .create-template.feature .create-template-desc {
  color: rgba(255, 255, 255, .9);
  font-size: 26rpx;
}

.create-reference-page .create-template-icon {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  z-index: 2;
  display: grid;
  place-items: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  color: #a50f22;
  background: #fff4f4;
  font-size: 24rpx;
  font-weight: 900;
}

.create-reference-page .create-template.feature .create-template-icon {
  left: 26rpx;
  right: auto;
  bottom: 30rpx;
  width: 76rpx;
  height: 76rpx;
  color: #f24940;
  background: #fff;
  font-size: 42rpx;
}

.create-machine-panel {
  margin-top: 30rpx;
  padding: 28rpx 24rpx 26rpx;
  border-radius: 16rpx;
  background: #fff;
}

.create-reference-page .create-machine-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin: 0;
  padding: 0;
  background: transparent;
}

.create-reference-page .create-machine-button {
  display: grid;
  grid-template-columns: 52rpx 1fr 36rpx;
  align-items: center;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #141922;
  background: #fff7f8;
  font-size: 29rpx;
  font-weight: 900;
}

.machine-icon {
  display: grid;
  place-items: center;
  width: 40rpx;
  height: 40rpx;
  color: #ff4a47;
  font-size: 30rpx;
  line-height: 1;
}

.machine-icon.grid {
  color: #9a5cff;
}

.machine-icon.flip {
  color: #ff7747;
}

.machine-arrow {
  color: #c60f2c;
  text-align: right;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 400;
}

.create-reference-page .create-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 32rpx 0 8rpx;
  color: #d01831;
  font-size: 26rpx;
  line-height: 1;
}

.create-contact-link {
  display: inline;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1;
}

.create-contact-link::after {
  border: 0;
}

.link-divider {
  color: #e2a2ab;
}

.reference-records {
  min-height: 100vh;
  padding-bottom: 136rpx;
  background: #f1f2f5;
}

.reference-records .record-tabs {
  height: 78rpx;
}

.reference-records .record-tab {
  font-size: 28rpx;
}

.reference-records .recommend-strip {
  min-height: 58rpx;
  padding: 0 10rpx;
  color: #ff7a1a;
  background: #fff0df;
}

.recommend-bell {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #ff7a1a;
  border-radius: 50%;
  box-sizing: border-box;
  font-size: 20rpx;
  line-height: 1;
}

.recommend-text {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reference-records .recommend-action {
  height: 50rpx;
  padding: 0 18rpx;
  border-radius: 6rpx;
  background: #ff912f;
  line-height: 50rpx;
}

.record-list {
  padding-top: 10rpx;
}

.record-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 430rpx;
  color: #8e949e;
  font-size: 25rpx;
  line-height: 1.4;
}

.empty-document {
  position: relative;
  width: 122rpx;
  height: 126rpx;
  margin-bottom: 28rpx;
}

.empty-paper {
  width: 82rpx;
  height: 104rpx;
  border: 8rpx solid #d0d3d8;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.empty-paper text {
  display: block;
  width: 48rpx;
  height: 6rpx;
  margin: 16rpx 0 0 14rpx;
  border-radius: 8rpx;
  background: #d0d3d8;
}

.empty-pencil {
  position: absolute;
  right: 8rpx;
  bottom: 12rpx;
  width: 42rpx;
  height: 72rpx;
  border: 8rpx solid #d0d3d8;
  border-radius: 10rpx;
  background: #f1f2f5;
  transform: rotate(45deg);
}

.reference-profile {
  min-height: 100vh;
