<view class="settings-page">
  <view class="settings-nav" style="height: {{navMetrics.navHeight}}px; padding-top: {{navMetrics.statusBarHeight}}px;">
    <view class="settings-back" bindtap="goBack">‹</view>
    <text>设置</text>
  </view>

  <view class="settings-content">
    <view class="settings-group">
      <view class="settings-row" bindtap="openSubscriptionSettings">
        <text>订阅消息设置</text><text class="row-arrow">›</text>
      </view>
      <view class="settings-row" bindtap="openAddress">
        <text>收货地址</text><text class="row-arrow">›</text>
      </view>
    </view>

    <view class="settings-group">
      <button class="settings-row native-row" open-type="feedback">
        <text>投诉与建议</text><text class="row-arrow">›</text>
      </button>
      <view class="settings-row" data-section="faq" bindtap="openHelp">
        <text>常见问题</text><text class="row-arrow">›</text>
      </view>
    </view>

    <view class="settings-group">
      <view class="settings-row" data-section="user" bindtap="openHelp">
        <text>用户协议</text><text class="row-arrow">›</text>
      </view>
      <view class="settings-row" data-section="privacy" bindtap="openHelp">
        <text>隐私政策</text><text class="row-arrow">›</text>
      </view>
      <view class="settings-row" bindtap="checkUpdate">
        <text>检测更新</text><text class="row-arrow">›</text>
      </view>
    </view>

    <button class="logout-button" wx:if="{{authenticated}}" bindtap="logout">退出登录</button>
  </view>
</view>
