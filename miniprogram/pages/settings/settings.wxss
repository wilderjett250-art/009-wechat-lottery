.settings-page {
  min-height: 100vh;
  background: #f4f4f4;
}

.settings-nav {
  position: sticky;
  z-index: 20;
  top: 0;
  display: flex;
  padding-right: 120rpx;
  padding-left: 120rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-bottom: 2rpx solid #f1f1f1;
  background: #fff;
  color: #171717;
  font-size: 30rpx;
  font-weight: 600;
}

.settings-back {
  position: absolute;
  bottom: 0;
  left: 24rpx;
  display: flex;
  width: 76rpx;
  height: 88rpx;
  align-items: center;
  color: #151515;
  font-size: 58rpx;
  font-weight: 300;
}

.settings-content {
  padding: 22rpx 20rpx 80rpx;
  box-sizing: border-box;
}

.settings-group {
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
}

.settings-row {
  display: flex;
  width: 100%;
  min-height: 94rpx;
  margin: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border: 0;
  border-bottom: 2rpx solid #f0f0f0;
  border-radius: 0;
  color: #29313c;
  background: #fff;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.3;
  text-align: left;
}

.settings-row:last-child {
  border-bottom: 0;
}

.row-arrow {
  flex: 0 0 auto;
  margin-left: 24rpx;
  color: #b7bdc5;
  font-size: 38rpx;
  font-weight: 300;
}

.native-row::after {
  border: 0;
}

.native-row > text:first-child {
  min-width: 0;
  flex: 1;
  text-align: left;
}

.logout-button {
  width: 350rpx;
  height: 86rpx;
  margin: 42rpx auto 0;
  border-radius: 10rpx;
  color: #e13f3b;
  background: #fff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 86rpx;
}

.logout-button::after {
  border: 0;
}
