.reference-launch {
  height: 100vh;
  overflow: hidden;
  background: #f2f2f2;
}

.form-navbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 60;
  display: grid;
  height: 128rpx;
  padding: 40rpx 28rpx 0;
  box-sizing: border-box;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  border-bottom: 2rpx solid #f0f0f0;
  background: #fff;
}

.form-navbar > text {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

.form-back {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  color: #111;
}

.form-back-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
  border-bottom: 4rpx solid #111;
  border-left: 4rpx solid #111;
  transform: rotate(45deg);
}

.launch-content {
  position: absolute;
  top: 128rpx;
  right: 0;
  left: 0;
  height: calc(100vh - 128rpx);
  padding-bottom: calc(118rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.template-strip {
  width: 100%;
  padding: 18rpx 18rpx 22rpx;
  box-sizing: border-box;
  white-space: nowrap;
  background: #fff;
}

.template-strip-row {
  display: inline-flex;
  gap: 14rpx;
}

.template-tab {
  display: flex;
  width: 172rpx;
  height: 136rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  color: #202020;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(0, 0, 0, .08);
  font-size: 25rpx;
}

.template-tab.active {
  border-color: #ef483e;
  color: #d93632;
  background: #fff8f7;
}

.template-tab-icon {
  font-size: 38rpx;
  line-height: 1;
}

.simple-section-title,
.condition-title {
  display: flex;
  padding: 28rpx 28rpx 14rpx;
  align-items: center;
  justify-content: space-between;
  color: #777;
  font-size: 27rpx;
}

.create-help {
  color: #12a36e;
  text-decoration: underline;
}

.reference-launch .create-form-panel {
  margin: 0 18rpx 20rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fff;
}

.reference-launch .create-preview {
  position: relative;
  height: calc(100vw - 80rpx);
  max-height: 680rpx;
  margin: 20rpx 22rpx 0;
  overflow: hidden;
  background: #f65b4e;
}

.custom-prize-image {
  width: 100%;
  height: 100%;
}

.reference-launch .change-image {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 4;
  display: flex;
  height: 56rpx;
  padding: 0 20rpx;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, .85);
  border-radius: 8rpx;
  color: #fff;
  background: rgba(115, 43, 36, .24);
  font-size: 24rpx;
}

.prize-list-scroll,
.prize-type-scroll {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
}

.prize-list-scroll {
  padding: 16rpx 22rpx 0;
}

.prize-list-row,
.prize-type-row {
  display: inline-flex;
  gap: 10rpx;
}

.prize-list-item {
  position: relative;
  display: flex;
  width: 220rpx;
  min-height: 88rpx;
  padding: 12rpx 38rpx 12rpx 14rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  border: 2rpx solid #e4e4e4;
  border-radius: 9rpx;
  font-size: 23rpx;
}

.prize-list-item.active {
  border-color: #12a36e;
  background: #effcf6;
}

.prize-list-item text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prize-remove {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  font-size: 32rpx;
}

.prize-type-scroll {
  padding: 18rpx 22rpx 10rpx;
}

.prize-type {
  display: flex;
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e1e1e1;
  border-radius: 7rpx;
  color: #343434;
  font-size: 23rpx;
}

.prize-type.active,
.draw-mode.active {
  border-color: #12aa74;
  color: #0a9966;
  background: #f1fff9;
  font-weight: 700;
}

.reference-launch .form-row,
.organizer-row,
.group-config-row,
.config-input-row {
  display: flex;
  min-height: 92rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid #f0f0f0;
  color: #191919;
  font-size: 27rpx;
}

.reference-launch .form-row input,
.config-input-row input,
.survey-config-row input {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  color: #303030;
  text-align: right;
  font-size: 25rpx;
}

.row-action-value,
.date-pickers,
.group-config-value,
.condition-radius {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #777;
  font-size: 25rpx;
}

.date-pickers {
  gap: 18rpx;
}

.row-muted {
  color: #888;
  font-size: 25rpx;
}

.number-input-with-unit {
  display: flex;
  min-width: 180rpx;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  color: #333;
}

.reference-launch .form-row .number-input-with-unit input {
  width: 150rpx;
  margin-left: 0;
}

.row-label-with-help {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.row-label-with-help text:last-child {
  color: #888;
  text-decoration: underline;
  font-size: 22rpx;
}

.form-error {
  margin: -2rpx 24rpx 10rpx;
  padding: 10rpx 14rpx;
  color: #d83b36;
  background: #fff0ef;
  font-size: 23rpx;
}

.draw-mode-row {
  display: grid;
  padding: 22rpx 22rpx 10rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.draw-mode {
  display: flex;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dedede;
  border-radius: 7rpx;
  font-size: 25rpx;
}

.add-prize,
.copy-box {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  border-top: 2rpx solid #f0f0f0;
  color: #777;
  font-size: 27rpx;
}

.creator-box {
  display: flex;
  min-height: 132rpx;
  margin: 0 24rpx;
  padding: 18rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 18rpx;
  border-radius: 8rpx;
  background: #f6f6f6;
}

.creator-box image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.intro-title {
  padding: 28rpx 26rpx 14rpx;
  font-size: 27rpx;
}

.intro-textarea {
  width: calc(100% - 48rpx);
  height: 170rpx;
  margin: 0 24rpx 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #eeeeee;
  border-radius: 8rpx;
  font-size: 25rpx;
}

.intro-image-grid {
  display: grid;
  padding: 0 24rpx 20rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.intro-image-item {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8rpx;
}

.intro-image-item image {
  width: 100%;
  height: 100%;
}

.intro-image-item text {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: rgba(0, 0, 0, .55);
}

.more-toggle {
  display: flex;
  min-height: 96rpx;
  margin: 0 18rpx 20rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #0aaa72;
  background: #fff;
  font-size: 27rpx;
  font-weight: 700;
}

.condition-list {
  margin: 0 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.condition-item {
  overflow: hidden;
  border-radius: 14rpx;
  background: #fff;
}

.condition-row {
  display: flex;
  min-height: 92rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #f0f0f0;
  font-size: 27rpx;
}

.condition-item .condition-row:last-child {
  border-bottom: 0;
}

.condition-switch {
  flex: 0 0 auto;
  pointer-events: none;
}

.condition-row > view {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 16rpx;
}

.condition-link {
  color: #8c8c8c;
  text-decoration: underline;
  font-size: 23rpx;
}

.condition-config-panel {
  border-bottom: 2rpx solid #f0f0f0;
  background: #fff;
}

.assist-config-panel {
  padding: 8rpx 26rpx 20rpx;
  box-sizing: border-box;
}

.assist-config-row {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  color: #353535;
  font-size: 25rpx;
}

.assist-config-input {
  display: flex;
  width: 168rpx;
  min-height: 52rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  align-items: center;
  border: 2rpx solid #e6e6e6;
  border-radius: 8rpx;
  color: #777;
}

.assist-config-input input {
  width: 92rpx;
  min-height: 52rpx;
  color: #191919;
  text-align: center;
}

.assist-config-tip {
  display: block;
  padding-top: 8rpx;
  color: #929292;
  font-size: 22rpx;
  line-height: 34rpx;
}

.condition-config-name {
  max-width: 420rpx;
  overflow: hidden;
  color: #666;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.condition-radius input {
  width: 120rpx;
  text-align: right;
}

.condition-editor-mask {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.42);
}

.condition-editor-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 18rpx 18rpx 0 0;
  background: #fff;
}

.condition-editor-head {
  display: flex;
  height: 96rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #f0f0f0;
  font-size: 31rpx;
  font-weight: 700;
}

.condition-editor-close {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  color: #7f858c;
  font-size: 44rpx;
  font-weight: 400;
}

.condition-editor-body {
  max-height: 54vh;
  padding: 22rpx 0 8rpx;
  box-sizing: border-box;
}

.condition-editor-field {
  margin-bottom: 22rpx;
}

.condition-editor-field > text,
.condition-editor-field > view:first-child text:first-child {
  display: block;
  margin-bottom: 12rpx;
  color: #25282c;
  font-size: 25rpx;
  font-weight: 600;
}

.condition-editor-field input,
.condition-editor-field textarea {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #e1e4e8;
  border-radius: 8rpx;
  background: #fff;
  font-size: 25rpx;
}

.task-proof-setting {
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #eef0f2;
}

.task-proof-setting view {
  display: flex;
  min-width: 0;
  padding-right: 20rpx;
  flex: 1;
  flex-direction: column;
}

.task-proof-setting text:first-child {
  color: #222b38;
  font-size: 26rpx;
}

.task-proof-setting text:last-child {
  margin-top: 6rpx;
  color: #8a9099;
  font-size: 21rpx;
  line-height: 1.45;
}

.condition-editor-field textarea {
  height: 180rpx;
}

.checkin-duration-field > view,
.checkin-reward-input {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  gap: 12rpx;
  color: #565c65;
  font-size: 24rpx;
}

.checkin-duration-field input,
.checkin-reward-input input {
  width: 112rpx;
  height: 64rpx;
  padding: 0 12rpx;
  flex: 0 0 112rpx;
  text-align: center;
}

.checkin-reward-mode {
  display: flex;
  height: 68rpx;
  align-items: center;
  gap: 36rpx;
  font-size: 24rpx;
}

.checkin-reward-mode label {
  display: flex;
  align-items: center;
}

.checkin-reward-mode radio {
  transform: scale(.82);
}

.checkin-editor-tip {
  display: block;
  margin-top: 10rpx;
  color: #8a9099;
  font-size: 21rpx;
  line-height: 1.5;
}

.survey-editor-field > view:first-child {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.remove-question {
  color: #dc263d;
  font-weight: 400 !important;
}

.condition-editor-action {
  display: flex;
  min-height: 88rpx;
  margin-bottom: 22rpx;
  padding: 0 20rpx;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #e1e4e8;
  border-radius: 8rpx;
  font-size: 25rpx;
}

.condition-editor-action text:last-child {
  max-width: 430rpx;
  overflow: hidden;
  color: #7b8188;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-question {
  display: flex;
  height: 76rpx;
  margin-bottom: 18rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cfd4d9;
  border-radius: 8rpx;
  color: #0aa96e;
  font-size: 25rpx;
}

.condition-editor-done {
  display: flex;
  height: 78rpx;
  margin: 16rpx 0 0;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #fff;
  background: #ef3f36;
  font-size: 28rpx;
  line-height: 78rpx;
}

.condition-editor-done::after {
  border: 0;
}

.advanced-panel {
  margin: 26rpx 18rpx 20rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fff;
}

.advanced-head {
  display: flex;
  min-height: 142rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 20rpx;
}

.advanced-badge {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #f2d791;
  background: #17233e;
  box-shadow: 0 4rpx 10rpx rgba(23, 35, 62, .16);
  font-size: 30rpx;
}

.advanced-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.advanced-copy text:first-child {
  color: #222;
  font-size: 29rpx;
  font-weight: 500;
}

.advanced-copy text:last-child {
  margin-top: 6rpx;
  color: #8c8c8c;
  font-size: 22rpx;
  line-height: 1.45;
}

.advanced-benefit-row {
  display: flex;
  min-height: 92rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  border-top: 2rpx solid #f0f0f0;
}

.advanced-benefit-row > text {
  flex: 0 0 auto;
  color: #222;
  font-size: 27rpx;
}

.advanced-benefit-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  color: #777;
  font-size: 23rpx;
  text-align: right;
}

.advanced-benefit-copy > text:first-child {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.advanced-info {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #a4a4a4;
  border-radius: 50%;
  color: #8f8f8f;
  font-size: 19rpx;
  font-family: Arial, sans-serif;
  line-height: 28rpx;
}

.advanced-row {
  display: flex;
  min-height: 88rpx;
  padding: 0 26rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid #f0f0f0;
}

.advanced-row > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.advanced-row > view > text:first-child {
  font-size: 26rpx;
}

.advanced-row > view > text:last-child,
.advanced-check {
  margin-top: 5rpx;
  color: #888;
  font-size: 22rpx;
}

.advanced-config-row {
  display: flex;
  min-height: 96rpx;
  padding: 0 26rpx 0 54rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid #f0f0f0;
  background: #fffafa;
}

.advanced-config-row > view {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.advanced-config-row > view text:first-child {
  color: #222;
  font-size: 25rpx;
}

.advanced-config-row > view text:last-child {
  margin-top: 6rpx;
  color: #929292;
  font-size: 21rpx;
}

.advanced-config-row > text {
  margin-left: 18rpx;
  color: #e54139;
  white-space: nowrap;
  font-size: 23rpx;
}

.launch-safe-space {
  height: calc(142rpx + env(safe-area-inset-bottom));
}

.reference-launch .create-bottom-bar {
  position: fixed;
  z-index: 200;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  width: 100%;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  grid-template-columns: 240rpx 1fr;
  gap: 16rpx;
  border-top: 2rpx solid #eeeeee;
  background: #fff;
  box-shadow: 0 -6rpx 18rpx rgba(0, 0, 0, .06);
}

.reference-launch .create-bottom-bar button {
  display: flex;
  width: 100%;
  height: 82rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.reference-launch .test-button {
  border: 2rpx solid #e8423c;
  color: #d93c36;
  background: #fff;
}

.reference-launch .launch-button {
  color: #fff;
  background: #ec443c;
}

.reference-launch .create-bottom-bar button::after {
  border: 0;
}

.type-intro-row {
  display: flex;
  min-height: 86rpx;
  margin: 16rpx 18rpx 8rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 14rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #202226;
  font-size: 27rpx;
}

.type-intro-icon {
  color: #08b978;
  font-size: 31rpx;
}

.type-intro-row .row-arrow,
.type-intro-status {
  margin-left: auto;
  color: #9da2a8;
}

.style-intro-row {
  color: #7d6200;
  background: #fff9df;
}

.fun-create-preview {
  background: #fff3c6;
}

.fun-gift-stage {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 52rpx;
  background: linear-gradient(#fff6ca 0 68%, #f7eab6 68% 100%);
}

.fun-gift-box,
.fun-small-gift {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #f8bd08;
  box-shadow: 0 14rpx 20rpx rgba(139, 89, 0, .13);
  font-weight: 700;
}

.fun-gift-box {
  width: 270rpx;
  height: 230rpx;
  font-size: 86rpx;
}

.fun-small-gift {
  width: 120rpx;
  height: 150rpx;
  font-size: 54rpx;
}

.fun-name-row input {
  padding-right: 130rpx;
}

.fun-random-button {
  display: flex;
  width: 108rpx;
  height: 54rpx;
  margin: 0 0 0 12rpx;
  padding: 0;
  flex: 0 0 108rpx;
  align-items: center;
