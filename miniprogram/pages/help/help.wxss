.help-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.help-section {
  margin-bottom: 18rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #fff;
}

.help-title,
.help-body {
  display: block;
}

.help-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 800;
}

.help-body {
  margin-top: 16rpx;
  color: #646b76;
  font-size: 27rpx;
  line-height: 1.75;
}

.help-service {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  border-radius: 14rpx;
  color: #fff;
  background: #ef3f36;
  font-size: 30rpx;
  line-height: 92rpx;
}

.help-service::after {
  border: 0;
}
