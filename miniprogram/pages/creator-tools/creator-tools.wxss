.creator-tools-page {
  min-height: 100vh;
  color: #24272d;
  background: #f3f4f6;
}

.creator-tools-nav {
  display: grid;
  padding-right: 24rpx;
  padding-left: 24rpx;
  box-sizing: border-box;
  grid-template-columns: 74rpx 1fr 74rpx;
  align-items: center;
  border-bottom: 2rpx solid #eceef1;
  background: #fff;
}

.creator-tools-nav > text {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

.nav-back {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
}

.nav-back > view {
  width: 22rpx;
  height: 22rpx;
  margin-left: 8rpx;
  transform: rotate(45deg);
  border-bottom: 4rpx solid #15181d;
  border-left: 4rpx solid #15181d;
}

.creator-tools-body {
  padding: 20rpx 18rpx calc(60rpx + env(safe-area-inset-bottom));
}

.loading-state,
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #949aa3;
}

.loading-state {
  height: 420rpx;
  font-size: 25rpx;
}

.empty-state {
  min-height: 560rpx;
  font-size: 26rpx;
}

.empty-box {
  display: grid;
  width: 112rpx;
  height: 98rpx;
  margin-bottom: 28rpx;
  place-items: center;
  border: 6rpx solid #cdd1d6;
  border-radius: 14rpx;
  color: #aeb3ba;
  font-size: 46rpx;
  font-weight: 700;
}

.empty-state button {
  width: 220rpx;
  height: 68rpx;
  margin-top: 34rpx;
  border-radius: 8rpx;
  color: #e6453e;
  border: 2rpx solid #e6453e;
  background: #fff;
  font-size: 26rpx;
  line-height: 68rpx;
}

.summary-strip {
  display: grid;
  min-height: 142rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-radius: 14rpx;
  background: #fff;
}

.summary-strip > view {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10rpx;
}

.summary-strip > view:not(:last-child)::after {
  position: absolute;
  top: 32rpx;
  right: 0;
  width: 2rpx;
  height: 76rpx;
  background: #eceef1;
  content: '';
}

.summary-strip text:first-child {
  font-size: 38rpx;
  font-weight: 700;
}

.summary-strip text:last-child {
  color: #7a818a;
  font-size: 23rpx;
}

.manager-list {
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fff;
}

.activity-row,
.claim-row,
.team-row,
.blacklist-row,
.prize-row {
  display: flex;
  min-height: 136rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  align-items: center;
  border-bottom: 2rpx solid #f0f1f3;
}

.activity-row:last-child,
.claim-row:last-child,
.team-row:last-child,
.blacklist-row:last-child,
.prize-row:last-child {
  border-bottom: 0;
}

.activity-row > image {
  width: 126rpx;
  height: 94rpx;
  flex: 0 0 126rpx;
  border-radius: 9rpx;
  background: #eceff2;
}

.activity-copy,
.claim-copy,
.team-copy,
.prize-copy {
  display: flex;
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
  flex-direction: column;
}

.row-title-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
}

.row-title-line > text:first-child {
  min-width: 0;
  overflow: hidden;
  flex: 1;
  color: #202328;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 700;
}

.status-pill {
  flex: 0 0 auto;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  color: #6c737d;
  background: #eef0f3;
  font-size: 19rpx;
}

.status-live {
  color: #13865f;
  background: #e8f8f1;
}

.status-draft {
  color: #986820;
  background: #fff5dc;
}

.status-ended,
.status-drawn {
  color: #69707a;
  background: #eceef1;
}

.activity-copy > text,
.claim-copy > text,
.team-copy > text,
.prize-copy > text {
  margin-top: 8rpx;
  overflow: hidden;
  color: #858c96;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 21rpx;
}

.row-actions {
  display: flex;
  margin-left: 14rpx;
  align-items: center;
}

.row-actions button,
.team-actions button,
.claim-button {
  min-width: 92rpx;
  height: 58rpx;
  padding: 0 16rpx;
  border-radius: 7rpx;
  color: #fff;
  background: #ec453e;
  font-size: 23rpx;
  line-height: 58rpx;
}

.row-actions > text {
  color: #b5bbc3;
  font-size: 40rpx;
}

.section-note {
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  color: #7a818a;
  background: #fff8e8;
  font-size: 23rpx;
  line-height: 1.5;
}

.claim-row > image {
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 82rpx;
  border-radius: 50%;
  background: #edf0f3;
}

.claim-button {
  margin-left: 12rpx;
}

.claim-button.secondary,
.top-actions button.secondary,
.team-actions button.danger {
  color: #d63e38;
  border: 2rpx solid #e2635d;
  background: #fff;
}

.top-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.top-actions.single {
  grid-template-columns: 1fr;
}

.top-actions button {
  height: 76rpx;
  border-radius: 10rpx;
  color: #fff;
  background: #e8453e;
  font-size: 26rpx;
  line-height: 76rpx;
  font-weight: 700;
}

.section-title {
  margin: 26rpx 4rpx 12rpx;
  color: #555c66;
  font-size: 25rpx;
}

.team-avatar,
.prize-icon {
  display: grid;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  place-items: center;
  border: 3rpx solid #383d43;
  border-radius: 12rpx;
  color: #33383e;
  background: #fff2ef;
  font-size: 22rpx;
  font-weight: 700;
}

.team-avatar.blocked {
  color: #d63e38;
  border-color: #d63e38;
  background: #fff0ef;
}

.team-copy > text:first-child,
.prize-copy > text:first-child {
  margin-top: 0;
  color: #272b30;
  font-size: 26rpx;
  font-weight: 700;
}

.team-actions {
  display: flex;
  margin-left: 12rpx;
  flex-direction: column;
  gap: 10rpx;
}

.team-actions button {
  min-width: 86rpx;
  height: 50rpx;
  font-size: 21rpx;
  line-height: 50rpx;
}

.growth-card {
  display: flex;
  min-height: 150rpx;
  padding: 26rpx;
  box-sizing: border-box;
  align-items: center;
  border-radius: 14rpx;
  background: #fff;
}

.growth-card image {
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  border-radius: 50%;
  background: #edf0f3;
}

.growth-card > view {
  display: flex;
  margin-left: 22rpx;
  flex-direction: column;
  gap: 10rpx;
}

.growth-card text:first-child {
  font-size: 30rpx;
  font-weight: 700;
}

.growth-card text:last-child {
  align-self: flex-start;
  padding: 5rpx 14rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #e4aa18;
  font-size: 20rpx;
}

.growth-grid {
  display: grid;
  margin-top: 18rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-radius: 14rpx;
  overflow: hidden;
  background: #fff;
}

.growth-grid > view {
  display: flex;
  min-height: 120rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10rpx;
  border-right: 2rpx solid #f0f1f3;
  border-bottom: 2rpx solid #f0f1f3;
}

.growth-grid > view:nth-child(3n) {
  border-right: 0;
}

.growth-grid text:first-child {
  font-size: 32rpx;
  font-weight: 700;
}

.growth-grid text:last-child {
  color: #7f8690;
  font-size: 22rpx;
}

.growth-rule {
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #fff;
}

.growth-rule > text {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
}

.growth-rule > view {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid #f0f1f3;
}

.growth-rule > view text:first-child {
  font-size: 25rpx;
}

.growth-rule > view text:last-child {
  color: #878e98;
  font-size: 22rpx;
}

.prize-state {
  margin-left: 12rpx;
  color: #df433d;
  font-size: 23rpx;
}

.prize-state.claimed {
  color: #198a65;
}

button::after {
  border: 0;
}
