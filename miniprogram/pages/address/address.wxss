.address-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.wechat-address-button,
.address-save {
  height: 92rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  line-height: 92rpx;
}

.wechat-address-button {
  margin-bottom: 24rpx;
  color: #12a06a;
  border: 2rpx solid #12a06a;
  background: #fff;
}

.address-form {
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
}

.address-row {
  display: flex;
  min-height: 104rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  align-items: center;
  border-bottom: 2rpx solid #f0f1f3;
}

.address-row > text {
  flex: 0 0 170rpx;
  color: #111827;
  font-size: 29rpx;
}

.address-row input,
.address-row textarea {
  flex: 1;
  color: #374151;
  font-size: 28rpx;
  text-align: right;
}

.address-detail {
  min-height: 170rpx;
  align-items: flex-start;
  padding-top: 28rpx;
}

.address-detail textarea {
  height: 120rpx;
  text-align: left;
}

.address-save {
  margin-top: 36rpx;
  color: #fff;
  background: #ef3f36;
}

.wechat-address-button::after,
.address-save::after {
  border: 0;
}
