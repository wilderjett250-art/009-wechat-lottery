.partnership-page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f3f4f6; }
.partnership-hero { display: flex; min-height: 170rpx; padding: 30rpx; box-sizing: border-box; justify-content: center; flex-direction: column; border-radius: 14rpx; color: #fff; background: #e9483f; }
.partnership-hero text:first-child { font-size: 38rpx; font-weight: 700; }
.partnership-hero text:last-child { margin-top: 12rpx; color: rgba(255,255,255,.86); font-size: 23rpx; }
.partnership-form { margin-top: 22rpx; overflow: hidden; border-radius: 14rpx; background: #fff; }
.form-row { display: flex; min-height: 104rpx; padding: 0 26rpx; align-items: center; border-bottom: 2rpx solid #f0f1f3; }
.form-row > text { width: 190rpx; color: #252a32; font-size: 27rpx; }
.form-row.required > text::after, .form-textarea.required > text:first-child::after { color: #e53d35; content: ' *'; }
.form-row input { min-width: 0; height: 80rpx; flex: 1; text-align: right; font-size: 26rpx; }
.form-textarea { position: relative; padding: 26rpx; }
.form-textarea > text:first-child { color: #252a32; font-size: 27rpx; }
.form-textarea textarea { width: 100%; height: 220rpx; margin-top: 20rpx; padding: 20rpx; box-sizing: border-box; border-radius: 8rpx; background: #f7f8f9; font-size: 25rpx; }
.form-textarea > text:last-child { position: absolute; right: 42rpx; bottom: 36rpx; color: #a6abb3; font-size: 21rpx; }
.partnership-submit { margin-top: 28rpx; border-radius: 8rpx; color: #fff; background: #e94038; font-size: 29rpx; font-weight: 700; }
