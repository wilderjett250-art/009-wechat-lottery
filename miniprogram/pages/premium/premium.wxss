.premium-page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f3f4f6; }
.premium-status { display: flex; min-height: 180rpx; padding: 32rpx; box-sizing: border-box; justify-content: center; flex-direction: column; border-radius: 14rpx; color: #f5e0a3; background: #17223c; }
.premium-status.active { background: #0e6b4b; }
.premium-status text:first-child { font-size: 34rpx; font-weight: 700; }
.premium-status text:last-child { margin-top: 12rpx; color: rgba(255,255,255,.76); font-size: 24rpx; }
.premium-list { margin-top: 20rpx; overflow: hidden; border-radius: 12rpx; background: #fff; }
.premium-list view { display: flex; min-height: 96rpx; padding: 18rpx 24rpx; box-sizing: border-box; justify-content: center; flex-direction: column; border-bottom: 2rpx solid #f0f1f3; }
.premium-list text:first-child { color: #232832; font-size: 27rpx; font-weight: 700; }
.premium-list text:last-child { margin-top: 7rpx; color: #878d96; font-size: 22rpx; }
.payment-note { display: flex; min-height: 92rpx; margin-top: 20rpx; padding: 0 24rpx; align-items: center; justify-content: space-between; border-radius: 12rpx; background: #fff; color: #252a32; font-size: 27rpx; }
.payment-note text:last-child { color: #e23e36; font-size: 32rpx; font-weight: 700; }
.premium-page > button { margin-top: 26rpx; color: #fff; background: #d91632; font-size: 27rpx; }
