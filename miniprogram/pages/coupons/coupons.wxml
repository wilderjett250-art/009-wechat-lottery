<view class="asset-page">
  <view class="asset-section-title">我的优惠券</view>
  <view class="coupon-card" wx:for="{{coupons}}" wx:key="id">
    <view class="coupon-value">{{item.value}}</view>
    <view class="coupon-info">
      <text class="asset-row-title">{{item.title}}</text>
      <text class="asset-row-sub">{{item.expiresText}}</text>
    </view>
    <text class="coupon-status">{{item.statusText}}</text>
  </view>
  <view class="asset-empty" wx:if="{{!coupons.length}}">
    <text>暂无可用优惠券</text>
    <text>获得的优惠券会显示在这里</text>
  </view>
</view>
