.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.52);
}

.privacy-dialog {
  width: 100%;
  max-width: 640rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 54rpx rgba(0, 0, 0, 0.18);
}

.privacy-title {
  display: block;
  color: #171717;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

.privacy-copy {
  margin-top: 24rpx;
  color: #5f6368;
  font-size: 28rpx;
  line-height: 1.75;
  text-align: left;
}

.privacy-link {
  color: #c80f2e;
}

.privacy-actions {
  display: grid;
  grid-template-columns: 1fr 1.45fr;
  gap: 20rpx;
  margin-top: 36rpx;
}

.privacy-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.privacy-actions button::after {
  border: 0;
}

.privacy-cancel {
  color: #4f545c;
  background: #f1f2f5;
}

.privacy-agree {
  color: #ffffff;
  background: #e9433d;
}
